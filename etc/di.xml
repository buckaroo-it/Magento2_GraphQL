<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Buckaroo\Magento2\Service\Store\PushUrlBuilder">
        <plugin name="buckaroo_graphql_push_url_modifier" type="Buckaroo\Magento2Graphql\Plugin\TransactionBuilder\PushUrlModifier" />
    </type>
    <type name="Buckaroo\Magento2\Gateway\Request\BasicParameter\PushUrlDataBuilder">
        <plugin name="buckaroo_graphql_push_url_modifier" type="Buckaroo\Magento2Graphql\Plugin\TransactionBuilder\PushUrlModifier" />
    </type>
    <type name="Buckaroo\Magento2\Model\Transaction\Status\ProcessResponse">
        <plugin name="buckaroo_graphql_group_transaction" type="Buckaroo\Magento2Graphql\Plugin\Transaction\ProcessResponsePlugin" />
    </type>
    <type name="Buckaroo\Magento2Graphql\Resolver\IdinOutputResolver">
        <arguments>
            <argument name="requestDataBuilder" xsi:type="object">IdinVerifyRequest</argument>
            <argument name="transferFactory" xsi:type="object">Buckaroo\Magento2\Gateway\Http\SDKTransferFactory</argument>
            <argument name="client" xsi:type="object">TransactionVerify</argument>
        </arguments>
    </type>
</config>
