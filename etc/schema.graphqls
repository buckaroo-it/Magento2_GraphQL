#Queries

type Query {
    getBuckarooIdin (cart_id: String!): BuckarooIdin @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\IdinResolver")
    @doc(description: "Get iDIN info for this session")

    getBuckarooGiftcardTransactions (cart_id: String!): BuckarooGiftcardTransactions @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\GiftcardTransactionListResolver")
    @doc(description: "Get giftcard transactions")
}

#Mutations

type Mutation {
    verifyBuckarooIdin (input: BuckarooIdinInput!): BuckarooIdinOutput @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\IdinOutputResolver")
    @doc(description: "Verify customer/session age")

    buckarooPaymentTransactionStatus(
        input: BuckarooPaymentTransactionInput!
    ): BuckarooPaymentTransactionOutput @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Cart\\ProcessTransactionOutput")

    setBuckarooReturnUrl(
        input: BuckarooReturnUrlInput!
    ): BuckarooReturnUrl @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Cart\\SetReturnUrl")

    buckarooProcessGiftcardTransaction(
        input: BuckarooProcessGiftcardTransactionInput
    ): BuckarooProcessGiftcardTransactionOutput @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\GiftcardTransactionResolver")

    buckarooProcessVoucherTransaction(
        input: BuckarooProcessVoucherTransactionInput
    ): BuckarooProcessGiftcardTransactionOutput @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\VoucherTransactionResolver")
}
input BuckarooReturnUrlInput {
    return_url: String! @doc(description: "Link to the success/failed order page"),
    cart_id: String! @doc(description: "Cart id")
}
type BuckarooReturnUrl {
    success:Boolean
}

input BuckarooProcessVoucherTransactionInput {
  cart_id: String! @doc(description: "Cart id")
  voucher_code: String!  @doc(description: "Voucher code")
}

input BuckarooProcessGiftcardTransactionInput {
  cart_id: String! @doc(description: "Cart id")
  giftcard_id: String!  @doc(description: "Giftcard id")
  card_number: String!  @doc(description: "Giftcard number")
  card_pin: String!  @doc(description: "Giftcard pin")
}

type BuckarooGiftcardTransactions {
    remainder_amount: Float!,
    already_paid: Float!,
    transactions: [GiftcardTransaction],
    available_payment_methods:[GiftcardAvailableMethods]  @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Giftcard\\AvailablePaymentMethods")
}

type BuckarooProcessGiftcardTransactionOutput {
  remainder_amount: Float!,
  already_paid: Float!,
  transaction: GiftcardTransaction!,
  available_payment_methods:[GiftcardAvailableMethods]  @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Giftcard\\AvailablePaymentMethods")
}

type GiftcardAvailableMethods {
    title: String!,
    code: String!
}
type GiftcardTransaction {
    amount: Float! @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Giftcard\\Amount")
    currency: String! @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Giftcard\\Currency")
    name: String! @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Giftcard\\Name")
    transaction_id: String! @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Giftcard\\TransactionId")
}


input BuckarooPaymentTransactionInput {
  transaction_id: String!  @doc(description: "Buckaroo transaction id")
}

type BuckarooPaymentTransactionOutput {
  payment_status: String!,
  status_code: Int!
}

# Overrides
type AvailablePaymentMethod {
    buckaroo_additional: [BuckarooAdditionalData]
    @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Cart\\AdditionalData")
    @doc(description: "Checkout configuration of this Buckaroo payment method (the same values the Luma checkout receives).")
}

type Order {
    buckaroo_additional: BuckarooOrderOutput
    @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Cart\\OrderOutput")
    @doc(description: "Buckaroo result of the order placed in this request. Deprecated together with placeOrder.order, use orderV2.")
}

type CustomerOrder {
    buckaroo_additional: BuckarooOrderOutput
    @resolver(class: "Buckaroo\\Magento2Graphql\\Resolver\\Cart\\OrderOutput")
    @doc(description: "Buckaroo result of the order placed in this request (placeOrder.orderV2). Null for other orders.")
}

# Payment method input: one field per Buckaroo method, named after the method code (Magento core pattern).
# Only methods that need extra checkout fields have a field; the other methods only need the code.
input PaymentMethodInput {
    buckaroo_magento2_afterpay: BuckarooAfterpayInput @doc(description: "Riverty | Afterpay (legacy)")
    buckaroo_magento2_afterpay2: BuckarooAfterpayInput @doc(description: "Riverty | Afterpay (legacy, second account)")
    buckaroo_magento2_afterpay20: BuckarooAfterpay20Input @doc(description: "Riverty")
    buckaroo_magento2_applepay: BuckarooApplepayInput @doc(description: "Apple Pay")
    buckaroo_magento2_billink: BuckarooBillinkInput @doc(description: "Billink")
    buckaroo_magento2_capayablein3: BuckarooIn3Input @doc(description: "In3")
    buckaroo_magento2_clicktopay: BuckarooClicktopayInput @doc(description: "Click to Pay")
    buckaroo_magento2_creditcard: BuckarooCreditcardInput @doc(description: "Credit and debit card (redirect)")
    buckaroo_magento2_creditcards: BuckarooCreditcardsInput @doc(description: "Credit and debit cards (Hosted Fields)")
    buckaroo_magento2_giftcards: BuckarooGiftcardsInput @doc(description: "Giftcards (redirect)")
    buckaroo_magento2_googlepay: BuckarooGooglepayInput @doc(description: "Google Pay")
    buckaroo_magento2_ideal: BuckarooIdealInput @doc(description: "iDEAL | Wero")
    buckaroo_magento2_mrcash: BuckarooMrcashInput @doc(description: "Bancontact")
    buckaroo_magento2_payperemail: BuckarooPayPerEmailInput @doc(description: "PayPerEmail")
    buckaroo_magento2_sepadirectdebit: BuckarooSepaDirectDebitInput @doc(description: "SEPA Direct Debit")
    buckaroo_magento2_zakelijkoprekening: BuckarooZakelijkOpRekeningInput @doc(description: "Zakelijk op Rekening (In3 business)")
}

input BuckarooAfterpayInput {
    termsCondition: String! @doc(description: "Consent to the Riverty terms; the plugin stores no field of this method without it")
    customer_DoB: String @doc(description: "Date of birth, DD/MM/YYYY")
    customer_telephone: String @doc(description: "Telephone; the billing address telephone is used when empty")
    customer_gender: String @doc(description: "1 = male, 2 = female")
    selectedBusiness: String @doc(description: "Business orders only: the business method value from buckaroo_additional businessMethod")
    COCNumber: String @doc(description: "Business orders only: Chamber of Commerce number")
    CompanyName: String @doc(description: "Business orders only: company name")
}

input BuckarooAfterpay20Input {
    customer_DoB: String @doc(description: "Date of birth, DD/MM/YYYY")
    customer_telephone: String @doc(description: "Telephone; the billing address telephone is used when empty")
    customer_identificationNumber: String @doc(description: "Identification number (Finland)")
    customer_coc: String @doc(description: "Business orders: Chamber of Commerce number")
}

input BuckarooApplepayInput {
    applepayTransaction: String! @doc(description: "Apple Pay payment token (JSON)")
    applepayCardNetwork: String @doc(description: "Card network of the Apple Pay token, checked against the allowed networks")
    billingContact: String @doc(description: "Apple Pay billing contact (JSON)")
}

input BuckarooBillinkInput {
    customer_gender: String
    customer_DoB: String @doc(description: "Date of birth, DD/MM/YYYY")
    customer_telephone: String
    customer_chamberOfCommerce: String @doc(description: "Business orders: Chamber of Commerce number")
    customer_VATNumber: String @doc(description: "Business orders: VAT number")
}

input BuckarooIn3Input {
    customer_DoB: String @doc(description: "Date of birth, DD/MM/YYYY (consumer orders)")
    customer_telephone: String
    customer_chamberOfCommerce: String @doc(description: "Business orders: Chamber of Commerce number")
}

input BuckarooZakelijkOpRekeningInput {
    customer_telephone: String
    customer_chamberOfCommerce: String @doc(description: "Chamber of Commerce number; the company comes from the billing or shipping address")
}

input BuckarooClicktopayInput {
    transient_token: String! @doc(description: "Click to Pay transient token")
    identifier: String @doc(description: "Click to Pay identifier")
}

input BuckarooCreditcardInput {
    card_type: String @doc(description: "Card code from buckaroo_additional cards, e.g. visa")
}

input BuckarooCreditcardsInput {
    customer_encrypteddata: String! @doc(description: "Token from Buckaroo Hosted Fields")
    customer_creditcardcompany: String @doc(description: "Card code, e.g. visa")
}

input BuckarooGiftcardsInput {
    giftcard_method: String @doc(description: "Giftcard code from buckaroo_additional availableGiftcards")
}

input BuckarooGooglepayInput {
    googlepayPaymentData: String! @doc(description: "Google Pay payment data (JSON)")
}

input BuckarooIdealInput {
    issuer: String @doc(description: "Only for iDEAL Fast Checkout: fastcheckout")
}

input BuckarooMrcashInput {
    client_side_mode: String @doc(description: "cc for the client-side card form")
    customer_encrypteddata: String
}

input BuckarooPayPerEmailInput {
    customer_gender: String
    customer_billingFirstName: String
    customer_billingMiddleName: String
    customer_billingLastName: String
    customer_email: String
}

input BuckarooSepaDirectDebitInput {
    customer_iban: String!
    customer_account_name: String!
    customer_bic: String @doc(description: "Required outside the Netherlands")
}

#Order output
type BuckarooOrderOutput {
    redirect: String @doc(description: "Url required for completing the payment")
    data: [BuckarooAdditionalOutputData] @doc(description: "Additional fields required for inline payments")
    transaction_id: String @doc(description: "Buckaroo transaction id")
}

type BuckarooAdditionalOutputData {
    key: String!
    value: String!
}

#Method additional data
type BuckarooAdditionalData {
    key: String!
    values: [BuckarooMultipleValues]  @doc(description: "Field values")
    value: String  @doc(description: "Field value")
}
type BuckarooMultipleValues {
    name: String!
    code: String!
    img: String
}

#idin

type BuckarooIdin {
    issuers: [BuckarooIdinIssuers]! @doc(description: "List of issuers available for iDIN verification")
    active: Boolean! @doc(description: "iDIN is active or not")
    verified: Boolean! @doc(description: "Age is verified for this customer/session")

}
type BuckarooIdinIssuers {
    name: String! @doc(description: "Issuer name")
    code: String! @doc(description: "Issuer code required for age verification")
}


input BuckarooIdinInput {
    issuer: String! @doc(description: "Issuer code required for age verification")
}

type BuckarooIdinOutput {
    redirect: String! @doc(description: "Url required for completion of age verification")
}
